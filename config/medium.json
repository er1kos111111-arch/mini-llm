{
  "_comment": "medium preset (~110M params). Use after tiny/small works. Needs high-RAM Colab.",
  "preset": "medium",
  "seed": 42,
  "tokenizer": {
    "vocab_size": 24000,
    "min_frequency": 2,
    "byte_level": true,
    "output_dir": "tokenizer/out_medium",
    "corpus_files": ["data/pretrain_corpus.txt", "data/conversations_text.txt"]
  },
  "model": {
    "vocab_size": 24000,
    "hidden_size": 512,
    "num_layers": 12,
    "num_heads": 8,
    "num_kv_heads": 8,
    "ffn_mult": 4.0,
    "context_length": 1024,
    "dropout": 0.0,
    "norm": "rmsnorm",
    "pos_encoding": "rope",
    "rope_theta": 10000.0,
    "tie_word_embeddings": false
  },
  "data": {
    "pretrain_corpus": "data/pretrain_corpus.txt",
    "sft_file": "data/conversations.jsonl",
    "val_split": 0.02,
    "max_seq_len": 1024,
    "assistant_only_loss": true
  },
  "train": {
    "stage": "sft",
    "epochs": 3,
    "batch_size": 4,
    "gradient_accumulation_steps": 16,
    "learning_rate": 2.0e-4,
    "weight_decay": 0.01,
    "warmup_ratio": 0.05,
    "max_grad_norm": 1.0,
    "scheduler": "cosine",
    "mixed_precision": "bf16",
    "num_workers": 0,
    "log_steps": 20,
    "eval_steps": 200,
    "save_steps": 400,
    "save_total_limit": 3,
    "output_dir": "checkpoints/medium_run",
    "resume_from": null
  },
  "generation": {
    "max_new_tokens": 160,
    "temperature": 0.8,
    "top_k": 50,
    "top_p": 0.9,
    "repetition_penalty": 1.1,
    "do_sample": true
  }
}
